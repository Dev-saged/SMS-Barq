<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+: only Barq's lists-and-settings file (groups, templates, rules, preferences).
  Messages, the database, crash logs and backups stay out. Cloud backup only when it is
  end-to-end encrypted; moving to a new phone with a cable or Wi-Fi works too.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="file" path="autobackup/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="autobackup/" />
    </device-transfer>
</data-extraction-rules>
